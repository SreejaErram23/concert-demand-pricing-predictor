k="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="91"/><column index="2" value="69"/><column index="3" value="65"/><column index="4" value="69"/><column index="5" value="164"/><column index="6" value="129"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Venues" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="67"/><column index="2" value="144"/><column index="3" value="84"/><column index="4" value="89"/><column index="5" value="42"/><column index="6" value="64"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="create tables ">CREATE TABLE Artists (
    artist_id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    genre TEXT,
    spotify_listeners INTEGER,
    billboard_chart_position INTEGER,
    current_status TEXT,
    buzz_score REAL
);

CREATE TABLE Venues (
    venue_id INTEGER PRIMARY KEY AUTOINCREMENT,
    venue_name TEXT NOT NULL,
    venue_type TEXT NOT NULL,
    city TEXT,
    state TEXT,
    capacity INTEGER
);

CREATE TABLE Tour_Dates (
    tour_date_id INTEGER PRIMARY KEY AUTOINCREMENT,
    venue_id INTEGER,
    artist_id INTEGER,
    date TEXT,
    tour_name TEXT,
    supporting_acts TEXT,
    FOREIGN KEY (venue_id) REFERENCES Venues(venue_id),
    FOREIGN KEY (artist_id) REFERENCES Artists(artist_id)
);

CREATE TABLE Ticket_Prices (
    ticket_price_id INTEGER PRIMARY KEY AUTOINCREMENT,
    tour_date_id INTEGER,
    price_tier TEXT,
    average_price REAL,
    FOREIGN KEY (tour_date_id) REFERENCES Tour_Dates(tour_date_id)
);

CREATE TABLE Predicted_Demand (
    predicted_demand_id INTEGER PRIMARY KEY AUTOINCREMENT,
    tour_date_id INTEGER,
    predicted_demand INTEGER,
    recommended_price REAL,
    FOREIGN KEY (tour_date_id) REFERENCES Tour_Dates(tour_date_id)
);</sql><sql name="artists insert statements ">INSERT INTO Artists (name, genre, spotify_listeners, billboard_chart_position, current_status)
VALUES ('Drake', 'Rap', 100000000, 12, 'Surprise-released 3 albums (Iceman, Habibti, Maid of Honour) at midnight May 15, 2026, revealed via livestream with virtually no warning; no tour currently announced');


INSERT INTO Artists (name, genre, spotify_listeners, billboard_chart_position, current_status)
VALUES ('Drake', 'Rap', 100000000, 12, 'Surprise-released 3 albums in May 2026; no tour announced yet');

DELETE FROM Artists WHERE artist_id IN (7, 8);</sql><sql name="Venues">INSERT INTO Venues (venue_name, venue_type, city, state, capacity)
